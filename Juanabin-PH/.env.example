# Reward engine environment template.
# Copy to .env and fill in. Never commit a filled-in .env — it is blocked by .gitignore.
# Secret seeds belong in the deployment host's environment variable store only.

# --- Stellar network ---
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- JBIN asset ---
# Public keys are safe to publish. The distributor secret is not.
JBIN_ASSET_CODE=JBIN
JBIN_ISSUER_PUBLIC_KEY=
JBIN_DISTRIBUTOR_PUBLIC_KEY=
JBIN_DISTRIBUTOR_SECRET=

# --- Database ---
DATABASE_URL=

# --- Authentication (Kinde) ---
KINDE_DOMAIN=
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_REDIRECT_URI=

# --- Reward rules ---
# Comma-separated authorized submitter IDs. An empty list rejects every submission.
SUBMITTER_ALLOWLIST=
DAILY_CAP_JBIN=60
REDEMPTION_THRESHOLD_JBIN=2000

# --- Application ---
APP_ENV=development
LOG_LEVEL=info
