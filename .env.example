# Local (host) development. Inside docker compose the api service overrides
# DATABASE_URL to use the "postgres" service hostname instead of 127.0.0.1.
#
# If a native Windows PostgreSQL service is holding port 5432 and you cannot stop
# it (that needs Administrator), set POSTGRES_HOST_PORT=5433 below and change the
# port in DATABASE_URL to 5433 as well. Nothing inside Docker is affected.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/juanabin
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
KINDE_AUTH_ENABLED=false
KINDE_ISSUER=
KINDE_AUDIENCE=juanabin-ph
